NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/instaframe
# Optional DNS fallback for MongoDB Atlas SRV lookup failures.
DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional. Tests start an isolated in-memory MongoDB when this is empty or points
# to the default local MongoDB address. Set only to a dedicated disposable server.
TEST_MONGO_URI=
REDIS_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ADMIN_MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
MOBILE_APP_URL=exp://localhost:8081
# Expo client value; use your computer's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_USAGE_CACHE_MS=300000
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_TOKEN=
MEDIA_CLEANUP_ALERT_AFTER_ATTEMPTS=3
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# Stories
MIN_REEL_DURATION_SECONDS=2
MAX_REEL_UPLOAD_MB=150
MAX_REEL_CAPTION_LENGTH=2200
MAX_REEL_HASHTAGS=20
MAX_STORY_IMAGE_MB=15
MAX_STORY_VIDEO_MB=75
MAX_STORY_VIDEO_SECONDS=60
STORY_EXPIRY_HOURS=24
STORY_EXPIRY_JOB_INTERVAL_MS=60000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=no-reply@instaframe.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
DISCOVERY_RATE_LIMIT_PER_HOUR=10
DISCOVERY_SCAN_MAX_UPLOAD_MB=5
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_MS=10000
AI_RATE_LIMIT_PER_HOUR=30
MAX_UPLOAD_MB=25
MAX_POST_VIDEO_MB=100
MAX_POST_VIDEO_SECONDS=120
MAX_CAROUSEL_ITEMS=10
MAX_POST_HASHTAGS=20
MAX_POST_CAPTION_LENGTH=2200
MAX_REEL_DURATION_SECONDS=90
MEDIA_SAFETY_ENFORCED=false
MEDIA_CLEANUP_INTERVAL_MS=30000
MEDIA_CLEANUP_MAX_ATTEMPTS=8
PUSH_PROVIDER_URL=
PUSH_PROVIDER_API_KEY=
BILLING_VERIFICATION_URL=
BILLING_VERIFICATION_SECRET=
BILLING_WEBHOOK_SECRET=
NOTIFICATION_RETENTION_DAYS=90
OPERATIONS_JOB_INTERVAL_MS=3600000
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_TOKEN=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
